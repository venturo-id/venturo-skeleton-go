# Timezone Configuration
TZ=UTC                                  # Timezone for the application (DO NOT CHANGE - must be UTC)

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tuai
DB_SSLMODE=disable

# Database Connection Pool Configuration
DB_MAX_CONNS=25                    # Maximum number of connections in the pool (default: 4)
DB_MIN_CONNS=5                     # Minimum number of idle connections (default: 0)
DB_MAX_CONN_LIFETIME=1h            # Maximum lifetime of a connection (default: 1h)
DB_MAX_CONN_IDLE_TIME=30m          # Maximum idle time before closing (default: 30m)
DB_HEALTH_CHECK_PERIOD=1m          # Interval for connection health checks (default: 1m)
DB_CONNECT_TIMEOUT=5s              # Timeout for establishing new connections (default: 5s)

# Server Configuration
SERVER_PORT=8080
ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-min-32-characters
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# Redis Configuration (used for permission cache — see internal/shared/authz)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=10                               # DB index reserved for tuai-be
REDIS_PERMISSION_TTL=10m                  # How long a user's permission set is cached before re-fetching from DB

# Auth Configuration
# Role ID assigned to a newly registered user inside their freshly created company.
# Defaults to the seeded "administrator" role (full company-scoped access).
AUTH_DEFAULT_ADMIN_ROLE_ID=00000000-0000-0000-0000-000000000002

# Email Configuration (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@tuai.id
SMTP_FROM_NAME=Tuai

# Frontend URLs (for email links)
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Support
SUPPORT_EMAIL=support@tuai.id

# Security Settings
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=30m
PASSWORD_RESET_EXPIRATION=1h
EMAIL_VERIFICATION_REQUIRED=true          # Set to false to auto-verify emails on signup
EMAIL_VERIFICATION_EXPIRATION=48h
MAX_PASSWORD_RESET_REQUESTS=3
MAX_VERIFICATION_RESEND=5

# Storage Configuration
# STORAGE_PROVIDER selects the backend: gcs (default) | s3 | minio.
# GCS uses the GCS_* vars above. S3/MinIO use the S3_* vars below.
# MinIO is S3-compatible: set S3_ENDPOINT + S3_USE_PATH_STYLE=true.
STORAGE_PROVIDER=gcs

# Google Cloud Storage
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_PROJECT_ID=your-gcs-project-id
GCS_CREDENTIALS_JSON=

S3_ENDPOINT=                              # e.g. http://localhost:9000 for MinIO
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false                   # true for MinIO
S3_PUBLIC_BASE_URL=                       # optional CDN/base URL for PublicURL


# Firebase (Google sign-in)
# - FIREBASE_PROJECT_ID: id project Firebase, wajib di-set agar backend bisa
#   memverifikasi ID token yang dikirim FE setelah signInWithPopup(Google).
# - FIREBASE_CREDENTIALS_JSON: isi JSON service-account key (single line / escaped).
#   Kosongkan kalau deploy di GCP dan pakai workload identity / ADC.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# RabbitMQ Configuration (optional/degraded — app still boots if unreachable)
# Set RABBITMQ_ENABLED=false to skip messaging entirely (no connection attempt).
# When true but the broker is down, the app logs a warning and continues
# without messaging (publisher/consumer not started).
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=skeleton.events
RABBITMQ_RECONNECT_INTERVAL=5s
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_PUBLISH_TIMEOUT=5s
# RABBITMQ_URL=                 # optional; full override, beats the components above

# Sentry Configuration (degraded/no-op when SENTRY_DSN is empty)
SENTRY_DSN=
SENTRY_ENVIRONMENT=                       # defaults to ENV when empty
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0             # 0.0 disables tracing; e.g. 0.1 = 10% of transactions

# Cache Configuration (reuses the Redis connection above — no new connection)
CACHE_KEY_PREFIX=cache
CACHE_DEFAULT_TTL=5m

# Notification Configuration (degraded/no-op when credentials are empty)
# Email reuses the SMTP_* config above. SMS uses Twilio; push uses FCM.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_CREDENTIALS_JSON=                      # service-account JSON; empty = push disabled