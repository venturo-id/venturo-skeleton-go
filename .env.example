# Comments go on their own line: `make` loads this file with `include`, and
# anything between the value and an inline "#" (spaces included) becomes part
# of the value. For the same reason a literal "#" inside a value must be
# written "\#", and a literal "$" must be written "$$".

# Timezone for the application (DO NOT CHANGE - must be UTC)
TZ=UTC

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Any characters work (the API escapes them, migrate/psql get PGPASSWORD) — write "#" as "\#" and "$" as "$$", see above
DB_PASSWORD=postgres
# `make db-reset` drops this database: never point it at another application's database
DB_NAME=timebox
DB_SSLMODE=disable

# Database Connection Pool Configuration
# MAX_CONNS: max connections in the pool. MIN_CONNS: idle connections kept open.
# MAX_CONN_LIFETIME / MAX_CONN_IDLE_TIME: when a connection is recycled.
# HEALTH_CHECK_PERIOD: health-check interval. CONNECT_TIMEOUT: dial timeout.
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# Server Configuration
SERVER_PORT=8080
# production: JSON logs, gin release mode, and `make db-reset` refuses to run
ENV=development
# Proxies allowed to set X-Forwarded-For: comma-separated IPs/CIDRs, e.g. the ingress
# controller's pod CIDR (10.42.0.0/16 on RKE). Empty trusts no proxy — fine locally, but
# behind an ingress every client then shares the ingress IP for rate limits and API-key
# IP whitelists.
TRUSTED_PROXIES=
# Browser origins allowed to call the API with credentials, comma-separated. CORS allows
# the Authorization, X-API-Key and X-Timebox-Client headers; the web app's refresh through
# the tb_refresh cookie is only accepted from these origins. For local frontend work add
# the dev servers, e.g. https://app.timebox.id,http://localhost:5173,http://localhost:5174
# The desktop app (Electron, no Origin) is not affected.
CORS_ALLOWED_ORIGINS=https://app.timebox.id,https://timebox.id

# JWT Configuration
# JWT_SECRET is required in every ENV (min 32 chars) — the API refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime (also sent as expires_in). Keep it short.
JWT_EXPIRATION=15m
# Refresh token lifetime (and Max-Age of the web app's tb_refresh cookie); every refresh
# starts a new one
JWT_REFRESH_EXPIRATION=168h

# Redis Configuration (permission cache and rate limits — the API does not start without it)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Every key starts with "timebox:", so a shared database is safe; use another index to keep
# two environments of Timebox apart on one server
REDIS_DB=0
# How long a user's authz state (active flag, roles, permissions) is cached before re-fetching from DB
REDIS_PERMISSION_TTL=10m

# MongoDB (audit log). Empty MONGO_URI: nothing is recorded and GET /audit-logs answers 503.
# When set, MongoDB must answer at startup or the API refuses to start; later outages only
# drop entries (logged). Put credentials in the URI, e.g.
# mongodb://user:password@10.10.2.30:27017/?authSource=admin
MONGO_URI=
MONGO_DATABASE=timebox
# How long an audit log entry is kept (TTL index); changing it updates the index on the next start
AUDIT_LOG_RETENTION=8760h

# Email (SMTP). Sending is enabled once SMTP_HOST and SMTP_FROM_EMAIL are set; without them
# every email (codes included) is only logged at debug level.
# SMTP_USER / SMTP_PASSWORD are optional but set together, as the plain values: SMTP AUTH
# base64-encodes them itself, so a value given already encoded fails with 535.
# The connection is TLS on port 465 and STARTTLS on any other port; plain text is only
# allowed to a loopback host (localhost, 127.0.0.0/8, ::1) without credentials.
# Local Mailpit (brew install mailpit && brew services start mailpit; UI http://localhost:8025):
# SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_USER and SMTP_PASSWORD empty.
# APP_NAME appears in subjects and templates.
APP_NAME=Timebox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Senders, plain addresses without a name. SMTP_FROM_EMAIL sends the codes (verification,
# password reset, email change); SMTP_NOTIFICATIONS_FROM_EMAIL sends the notices (welcome,
# account locked, password or email changed, account closed, Google linked or unlinked).
# Empty SMTP_NOTIFICATIONS_FROM_EMAIL: SMTP_FROM_EMAIL sends those too. The SMTP provider
# must be allowed to send from both (verified domain, SPF/DKIM).
SMTP_FROM_EMAIL=no-reply@timebox.id
SMTP_NOTIFICATIONS_FROM_EMAIL=notifications@timebox.id
# Empty: the sender name is APP_NAME
SMTP_FROM_NAME=
SUPPORT_EMAIL=support@timebox.id

# The app's base URL: the target of the welcome email's button
FRONTEND_URL=https://app.timebox.id

# Security Settings
# Wrong passwords in a row before the account is locked, and for how long.
# The count restarts once a lock has expired.
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=30m
# true = sign-in refused until the email is verified (signup emails a 6-digit code; the user
# can ask for another at /auth/verify-email/resend). Needs SMTP: the API refuses to start
# otherwise. Recommended in production once SMTP works.
EMAIL_VERIFICATION_REQUIRED=false
# Emailed 6-digit codes (email verification, password reset, email change): how long one
# works, how many wrong guesses kill it (at least 1), and the minimum gap between two codes
# to the same address (for an email change: to the same account)
OTP_EXPIRATION=15m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=1m
# How long the reset_token a right password reset code is traded for works
RESET_TOKEN_EXPIRATION=10m
# Verification / reset codes one account may receive per hour; further requests get the
# same answer but send nothing. MAX_VERIFICATION_EMAILS also caps email change codes
# (POST /account/email answers 429 beyond it).
MAX_VERIFICATION_EMAILS=5
MAX_PASSWORD_RESET_EMAILS=3
# Per client IP (an IPv6 client counts per /64), for each public /auth endpoint (signup,
# signin, google/client, google, refresh, verify-email, verify-email/resend,
# forgot-password, reset-password/verify, reset-password — separate buckets)
AUTH_RATE_LIMIT=20
AUTH_RATE_LIMIT_WINDOW=1m

# Cloudflare R2 (profile photos). Storage is enabled once the first four are set.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: the S3 credentials of an R2 API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Base URL the bucket is publicly served from (custom domain), e.g. https://cdn.timebox.id.
# Every avatar_url is <R2_PUBLIC_URL>/avatars/<user_id>/<id>.jpg, so the desktop app's CSP
# img-src must allow this origin. Avatars need R2 and R2_PUBLIC_URL: without either,
# PUT/DELETE /users/me/avatar answer 503 and Google profile pictures are not copied.
R2_PUBLIC_URL=

# Google sign-in (OAuth authorization code + PKCE; the API exchanges the code). One OAuth
# client per platform, created in Google Cloud Console; a platform left empty answers 503.
# ID and secret are set together.
# - GOOGLE_DESKTOP_*: client of type "Desktop app", for the Electron app (loopback redirect
#   http://127.0.0.1:<port>/..., nothing to register).
# - GOOGLE_WEB_*: client of type "Web application", for the browser app.
# - GOOGLE_WEB_REDIRECT_URIS: the web client's redirect URIs, comma-separated, exactly as
#   registered with Google; https only (http for localhost), required with the web client.
#   Production: https://app.timebox.id/oauth/google
#   Development: http://localhost:5173/oauth/google,http://localhost:5174/oauth/google
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_WEB_REDIRECT_URIS=

# Discord alerts (optional): log entries at DISCORD_ALERT_LEVEL (warn or error) and above
# are posted to the webhook, batched per DISCORD_ALERT_DEBOUNCE. DISCORD_ALERT_SOURCE names
# the sender; empty uses the hostname.
DISCORD_ALERT_WEBHOOK=
DISCORD_ALERT_LEVEL=error
DISCORD_ALERT_DEBOUNCE=10s
DISCORD_ALERT_SOURCE=

# Initial super admin — read only by `make seed-admin` (cmd/seed-admin), never by the API.
# - SEED_ADMIN_EMAIL: an address you control. Google sign-in links by verified email,
#   so whoever owns this mailbox can sign in as super admin.
# - SEED_ADMIN_USERNAME: 3-50 chars, letters/numbers/./_/-, starting with a letter or number.
# - SEED_ADMIN_PASSWORD: 8-72 bytes with upper, lower and a number, not containing the
#   email name; change it after the first sign-in. Only used when the account is created.
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=
